# Copie este arquivo para .env.local (não versionado) e preencha os IDs reais.
# Deixar uma variável vazia/ausente simplesmente não carrega aquele script — sem erro, sem custo de performance.

# Google Tag Manager — Container ID (formato GTM-XXXXXXX)
# Encontre em: tagmanager.google.com > seu container > canto superior direito
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Só preencha se for usar o GA4 direto, sem passar pelo Tag Manager.
# Se o GA4 já estiver configurado dentro do próprio GTM, deixe esta variável vazia para não duplicar o rastreamento.
# Encontre em: analytics.google.com > Admin > Fluxos de dados > seu fluxo web
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel — Pixel ID (só números)
# Encontre em: business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=

# URL do Google Apps Script (Web App) que recebe o cadastro do formulário de apoio e grava na planilha.
# SEM prefixo NEXT_PUBLIC_ de propósito — essa URL fica só no servidor, nunca é exposta ao navegador.
# Veja o passo a passo de como criar/publicar o script na mensagem do Claude Code que introduziu esta variável.
SHEETS_WEBHOOK_URL=
