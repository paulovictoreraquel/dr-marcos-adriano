# Copie este arquivo para .env.local (não versionado) e preencha os valores reais.
# Variáveis vazias/ausentes não carregam o respectivo serviço.

# URL pública completa, sem barra final. Usada em canonical, sitemap e dados estruturados.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager — Container ID (formato GTM-XXXXXXX)
# Encontre em: tagmanager.google.com > seu container > canto superior direito
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Se o GA4 já estiver configurado dentro do GTM, deixe vazio para não duplicar o rastreamento.
NEXT_PUBLIC_GA_ID=

# Meta Pixel — Pixel ID (somente números)
# Encontre em: business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=

# URL do Google Apps Script que recebe o cadastro e grava na planilha.
# Sem prefixo NEXT_PUBLIC_ para permanecer somente no servidor.
SHEETS_WEBHOOK_URL=
